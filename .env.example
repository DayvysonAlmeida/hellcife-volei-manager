# ============================================================
# HellCife Vôlei Manager — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha os valores.
# Em produção (Cloud Run), configure como Environment Variables.
# ============================================================

# ── Django Core ──────────────────────────────────────────────
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Google Cloud Run ─────────────────────────────────────────
# URL pública do serviço no Cloud Run (ex: https://hellcife-xxxx.run.app)
# Deixe vazio em desenvolvimento local.
CLOUDRUN_SERVICE_URL=

# ── Banco de Dados (Neon PostgreSQL) ─────────────────────────
# Em dev local, deixe vazio para usar SQLite.
# Em produção, use a connection string do Neon:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# ── Cloudinary (Storage de Mídia) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# ── CORS ─────────────────────────────────────────────────────
# Origens permitidas separadas por vírgula.
# Em produção, adicione o domínio do Vercel.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Segurança (apenas produção) ──────────────────────────────
SECURE_SSL_REDIRECT=True

# ── Gateway de Pagamento (Asaas) ─────────────────────────────
ASAAS_API_KEY=
ASAAS_API_URL=https://sandbox.asaas.com/api/v3
ASAAS_WEBHOOK_TOKEN=
